# Als ".htaccess" in den Ordner /foxradio auf dem Webspace legen.
# Pfad zur .htpasswd absolut angeben, den zeigt das Hosting-Panel
# (bei Strato z. B. /mnt/webXXX/.../foxradio/.htpasswd).
AuthType Basic
AuthName "FoxRadio"
AuthUserFile /ABSOLUTER/PFAD/foxradio/.htpasswd
Require valid-user

# Kein Verzeichnislisting, JSON und MP3 sauber ausliefern, nichts cachen,
# damit die App morgens die neue playlist.json bekommt.
Options -Indexes
AddType application/json .json
AddType audio/mpeg .mp3
<FilesMatch "\.(json)$">
  Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>
